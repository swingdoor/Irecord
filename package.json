{
  "name": "irecord",
  "version": "0.9.1",
  "description": "你说我记 - 本地语音识别转写工具",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "clean": "rm -rf dist release",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:mac:clean": "npm run clean && npm run build:mac",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.irecord.app",
    "productName": "iRecord",
    "executableName": "irecord",
    "npmRebuild": false,
    "electronVersion": "41.2.1",
    "directories": {
      "output": "release/${version}"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "files": [
        "!resources${/*}"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "files": [
        "!resources${/*}"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "!node_modules/antd/**",
      "!node_modules/@ant-design/**",
      "!node_modules/@rc-component/**",
      "!node_modules/rc-*/**",
      "!node_modules/lucide-react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react/**",
      "!node_modules/@tiptap/**",
      "!node_modules/prosemirror-*/**",
      "!node_modules/@floating-ui/**",
      "!node_modules/wavesurfer.js/**",
      "!node_modules/@babel/**",
      "!node_modules/micromark*/**",
      "!node_modules/@codemirror/**",
      "!node_modules/highlight.js/**",
      "!node_modules/@tailwindcss/**",
      "!node_modules/tailwindcss/**"
    ],
    "extraResources": [
      {
        "from": "src/main/keywords/extract.js",
        "to": "extract.js"
      },
      {
        "from": "resources/ffmpeg",
        "to": "resources/ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      },
      {
        "from": "resources/runtimes/sherpa-onnx",
        "to": "resources/runtimes/sherpa-onnx"
      },
      {
        "from": "resources/models/silero-vad",
        "to": "resources/models/silero-vad"
      },
      {
        "from": "resources/models/speaker-diarization",
        "to": "resources/models/speaker-diarization"
      },
      {
        "from": "resources/models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17",
        "to": "resources/models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/fft.js/**",
      "node_modules/nodejieba/**",
      "node_modules/sql.js/**"
    ]
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@tiptap/extension-bubble-menu": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "antd": "^6.3.6",
    "fft.js": "^4.0.4",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.8.0",
    "nodejieba": "^3.5.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "tar": "^7.5.15",
    "unbzip2-stream": "^1.4.3",
    "wavesurfer.js": "^7.12.6",
    "zustand": "^5.0.12"
  }
}
