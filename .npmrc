# Electron 二进制默认从 github.com 下载，国内较慢。
# 指向 npmmirror 镜像加速。npm registry 本身请用各自环境配置（不在此固定，避免强加给其他开发者）。
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 打包用的工具二进制（dmg-builder 等）。
# 当 registry 指向 npmmirror 时，electron-builder 会自动拼出错误的 cdn.npmmirror.com/binaries/electron/ 路径导致 404；
# 此项被 binDownload.js 最先读取（npm_config_electron_builder_binaries_mirror），覆盖其错误默认值。
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
